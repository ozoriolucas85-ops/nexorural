# NexoRural — reglas de Apache para la carpeta del proyecto
# No mostrar listados de carpetas.
Options -Indexes

# Ocultar Git, archivos ocultos y los scripts de Windows (no son parte de la web).
RedirectMatch 404 /\.git(/|$)
RedirectMatch 404 /scripts/
RedirectMatch 404 /paquete-hosting/
# Las pruebas de punta a punta solo corren con tests\correr-pruebas.bat (servidor de prueba propio).
RedirectMatch 404 /tests/e2e/
RedirectMatch 404 /tests/.*\.(ps1|bat)$
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Tipo correcto para el manifiesto de la app.
AddType application/manifest+json .webmanifest

# Que el navegador SIEMPRE pregunte si hay una versión nueva de la página
# (si no cambió, responde "304 sin cambios" y no se vuelve a descargar).
# Evita quedarse con JavaScript viejo después de una actualización.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
